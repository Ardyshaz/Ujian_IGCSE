rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(data) { return signedIn() && data.ownerId == request.auth.uid; }
  function validScore(data) {
   // Force floating-point arithmetic. Integer division truncates partial scores.
   let expected = 100.0 * data.correct / data.total;
   return data.score >= expected - 0.000001 && data.score <= expected + 0.000001;
  }
  match /students/{studentId} {
   allow read: if owner(resource.data);
   allow delete: if owner(resource.data) && !existsAfter(/databases/$(database)/documents/hallConsents/$(studentId));
   allow create: if owner(request.resource.data)
    && request.resource.data.keys().hasOnly(['id','ownerId','display_name','guardian_name','year_level','school_name','state','createdAt'])
    && request.resource.data.id == studentId
    && request.resource.data.display_name is string
    && request.resource.data.display_name.size() > 0 && request.resource.data.display_name.size() <= 60
    && request.resource.data.guardian_name is string && request.resource.data.guardian_name.size() <= 60
    && request.resource.data.year_level is string && request.resource.data.year_level.size() <= 30
    && request.resource.data.school_name is string && request.resource.data.school_name.size() <= 100
    && (!('state' in request.resource.data) || validState(request.resource.data.state))
    && request.resource.data.createdAt == request.time;
   allow update: if owner(resource.data) && owner(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name','guardian_name','year_level','school_name','state'])
    && request.resource.data.display_name is string && request.resource.data.display_name.size() > 0 && request.resource.data.display_name.size() <= 60
    && request.resource.data.guardian_name is string && request.resource.data.guardian_name.size() <= 60
    && request.resource.data.year_level is string && request.resource.data.year_level.size() <= 30
    && request.resource.data.school_name is string && request.resource.data.school_name.size() <= 100
    && (!('state' in request.resource.data) || validState(request.resource.data.state));
  }
  match /attempts/{attemptId} {
   // A transaction may read its as-yet nonexistent deterministic attempt ID.
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/attempts/$(attemptId)) || owner(resource.data));
   allow list, delete: if owner(resource.data);
   allow create: if owner(request.resource.data)
    && request.resource.data.keys().hasOnly(['id','quizId','studentId','ownerId','subject','mode','status','date','startedAt','dailyDate','total','correct','incorrect','unanswered','percentage','category','duration','answers','score','createdAt'])
    && request.resource.data.id == attemptId && request.resource.data.quizId == attemptId
    && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.ownerId == request.auth.uid
    && request.resource.data.subject in ['english','mathematics','science','mixed']
    && request.resource.data.mode in ['practice','examination','challenge','daily']
    && request.resource.data.status in ['submitted','expired']
    && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 50
    && request.resource.data.answers is list && request.resource.data.answers.size() == request.resource.data.total
    && request.resource.data.correct is int && request.resource.data.correct >= 0
    && request.resource.data.incorrect is int && request.resource.data.incorrect >= 0
    && request.resource.data.unanswered is int && request.resource.data.unanswered >= 0
    && request.resource.data.correct + request.resource.data.incorrect + request.resource.data.unanswered == request.resource.data.total
    && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100
    && request.resource.data.percentage == request.resource.data.score
    && validScore(request.resource.data)
    && request.resource.data.date is string && request.resource.data.date.size() <= 40
    && request.resource.data.startedAt is number && request.resource.data.duration is number && request.resource.data.duration >= 0
    && request.resource.data.createdAt == request.time;
   allow update: if false;
  }
  match /feedback/{feedbackId} {
   // Project admins read through Firebase Console/IAM. No web client can read comments.
   allow read, update, delete: if false;
   allow create: if signedIn()
    && request.resource.data.keys().hasAll(['ownerId','category','message','displayName','page','createdAt'])
    && request.resource.data.keys().hasOnly(['ownerId','category','message','displayName','page','createdAt'])
    && owner(request.resource.data)
    && request.resource.data.category in ['cadangan','masalah','soalan','lain']
    && request.resource.data.message is string
    && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000
    && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
    && request.resource.data.page in ['home','quiz','bank','progress','student','parent','about','session','result']
    && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/feedbackRateLimits/$(request.auth.uid)).data.submissionId == feedbackId
    && getAfter(/databases/$(database)/documents/feedbackRateLimits/$(request.auth.uid)).data.lastSubmittedAt == request.time;
  }
  match /feedbackRateLimits/{uid} {
   // Private receipt contains no message or nickname; supports safe acknowledgement retry.
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, delete: if false;
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasAll(['submissionId','lastSubmittedAt'])
    && request.resource.data.keys().hasOnly(['submissionId','lastSubmittedAt'])
    && request.resource.data.submissionId is string && request.resource.data.submissionId.size() <= 80
    && request.resource.data.lastSubmittedAt == request.time
    && (!exists(/databases/$(database)/documents/feedbackRateLimits/$(uid))
        || request.time >= resource.data.lastSubmittedAt + duration.value(60,'s'))
    && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.submissionId)).data.ownerId == uid
    && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.submissionId)).data.createdAt == request.time;
  }
  function validState(value) {
   return value is string && value in ['', 'Johor','Kedah','Kelantan','Melaka','Negeri Sembilan','Pahang','Perak','Perlis','Pulau Pinang','Sabah','Sarawak','Selangor','Terengganu','W.P. Kuala Lumpur','W.P. Labuan','W.P. Putrajaya'];
  }
  match /hallConsents/{studentId} {
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/hallConsents/$(studentId)) || owner(resource.data));
   allow list: if false;
   allow update: if owner(resource.data) && validAutoPreference(request.resource.data,studentId)
    && request.resource.data.publicId == resource.data.publicId
    && request.resource.data.createdAt == resource.data.createdAt
    && (resource.data.version == 1 || request.resource.data.alias == resource.data.alias)
    && (request.resource.data.enabled || !existsAfter(/databases/$(database)/documents/hallEntries/$(resource.data.publicId)));
   allow create: if owner(request.resource.data)
    && get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid
    && ((validAutoPreference(request.resource.data,studentId)) || (
    request.resource.data.keys().hasAll(['ownerId','publicId','alias','version','guardianConfirmed','createdAt'])
    && request.resource.data.keys().hasOnly(['ownerId','publicId','alias','version','guardianConfirmed','createdAt'])
    && request.resource.data.publicId is string && request.resource.data.publicId.matches('^[a-f0-9-]{36}$')
    && request.resource.data.alias is string && request.resource.data.alias.size() >= 2 && request.resource.data.alias.size() <= 24
    && !request.resource.data.alias.matches('.*[@<>/\\\\].*') && !request.resource.data.alias.matches('.*[0-9]{5}.*')
    && request.resource.data.version == 1 && request.resource.data.guardianConfirmed == true
    && request.resource.data.createdAt == request.time))
    && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/hallOwners/$(request.resource.data.publicId)).data.ownerId == request.auth.uid
    && getAfter(/databases/$(database)/documents/hallOwners/$(request.resource.data.publicId)).data.studentId == studentId;
   allow delete: if owner(resource.data)
    && !existsAfter(/databases/$(database)/documents/hallOwners/$(resource.data.publicId))
    && !existsAfter(/databases/$(database)/documents/hallEntries/$(resource.data.publicId));
  }
  function validAutoPreference(data,studentId) {
   return owner(data)
    && get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid
    && data.keys().hasAll(['ownerId','publicId','alias','version','enabled','createdAt'])
    && data.keys().hasOnly(['ownerId','publicId','alias','version','enabled','createdAt'])
    && data.publicId is string && data.publicId.matches('^[a-f0-9-]{36}$')
    && data.alias is string && data.alias.matches('^Pelajar [A-F0-9]{6}$')
    && data.version == 2 && data.enabled is bool;
  }
  function validHallSubject(data) {
   let expected = data.count >= 30 ? 100.0 * data.correct / data.count : 0;
   return data.keys().hasAll(['count','correct','accuracy']) && data.keys().hasOnly(['count','correct','accuracy'])
    && data.count is int && data.count >= 0 && data.count <= 100
    && (data.count < 30 ? data.correct == null && data.accuracy == null
        : data.correct is int && data.correct >= 0 && data.correct <= data.count
          && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
          && data.accuracy >= expected - 0.051 && data.accuracy <= expected + 0.051);
  }
  function validHallEntry(data,publicId) {
   let link = get(/databases/$(database)/documents/hallOwners/$(publicId)).data;
   let preference = getAfter(/databases/$(database)/documents/hallConsents/$(link.studentId)).data;
   return signedIn() && link.ownerId == request.auth.uid && preference.ownerId == request.auth.uid
    && preference.publicId == publicId && preference.version == 2 && preference.enabled == true
    && data.alias == preference.alias && data.alias.matches('^Pelajar [A-F0-9]{6}$')
    && data.keys().hasAll(['alias','weekStart','uniqueQuestions','activeDays','subjects','version','source','explorerScore','consistencyScore','englishScore','mathematicsScore','scienceScore','publishedAt','expiresAt'])
    && data.keys().hasOnly(['alias','weekStart','uniqueQuestions','activeDays','subjects','version','source','explorerScore','consistencyScore','englishScore','mathematicsScore','scienceScore','publishedAt','expiresAt'])
    && data.version == 2 && data.source == 'self_reported'
    && data.weekStart is string && data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && data.uniqueQuestions is int && data.uniqueQuestions >= 1 && data.uniqueQuestions <= 300
    && data.activeDays is int && data.activeDays >= 1 && data.activeDays <= 7
    && data.explorerScore == data.uniqueQuestions && data.consistencyScore == data.activeDays
    && data.subjects.keys().hasAll(['english','mathematics','science']) && data.subjects.keys().hasOnly(['english','mathematics','science'])
    && validHallSubject(data.subjects.english) && validHallSubject(data.subjects.mathematics) && validHallSubject(data.subjects.science)
    && data.englishScore == (data.subjects.english.count >= 30 ? data.subjects.english.accuracy : -1)
    && data.mathematicsScore == (data.subjects.mathematics.count >= 30 ? data.subjects.mathematics.accuracy : -1)
    && data.scienceScore == (data.subjects.science.count >= 30 ? data.subjects.science.accuracy : -1)
    && data.publishedAt == request.time && data.expiresAt is timestamp
    && data.expiresAt > request.time && data.expiresAt <= request.time + duration.value(7,'d');
  }
  match /hallOwners/{publicId} {
   allow get: if owner(resource.data);
   allow list, update: if false;
   allow create: if owner(request.resource.data)
    && request.resource.data.keys().hasAll(['ownerId','studentId','createdAt'])
    && request.resource.data.keys().hasOnly(['ownerId','studentId','createdAt'])
    && request.resource.data.studentId is string
    && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/hallConsents/$(request.resource.data.studentId)).data.publicId == publicId
    && getAfter(/databases/$(database)/documents/hallConsents/$(request.resource.data.studentId)).data.ownerId == request.auth.uid;
   allow delete: if owner(resource.data)
    && !existsAfter(/databases/$(database)/documents/hallConsents/$(resource.data.studentId))
    && !existsAfter(/databases/$(database)/documents/hallEntries/$(publicId));
  }
  match /hallEntries/{publicId} {
   // Only curated, consented aggregate fields are published by CLI IAM, never raw learner records.
   allow get: if true;
   allow list: if request.query.limit != null && request.query.limit <= 30;
   allow create, update: if validHallEntry(request.resource.data,publicId);
   allow delete: if signedIn()
    && get(/databases/$(database)/documents/hallOwners/$(publicId)).data.ownerId == request.auth.uid;
  }
  match /{document=**} { allow read,write: if false; }
 }
}
